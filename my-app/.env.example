# Local development only. Production env vars live in Cloudflare:
#  - Public vars  → wrangler.toml [vars]
#  - Secrets      → `wrangler secret put <NAME>`

BETTER_AUTH_SECRET=replace-with-a-long-random-string-min-32-chars
BETTER_AUTH_URL=http://localhost:4321
PUBLIC_ORIGIN=http://localhost:4321
SITE=http://localhost:4321
ASTRO_DB_REMOTE_URL=libsql://your-db-name-your-org.turso.io
ASTRO_DB_APP_TOKEN=replace-with-a-turso-db-token
