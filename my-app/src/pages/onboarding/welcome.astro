---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import Avatar from '../../components/Avatar.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/onboarding/welcome');

if (user.onboardingStep === 'done') {
  return Astro.redirect('/app/today');
}

// "Back" target: send the user to whatever same-origin page they came from
// (Referer). Fall back to / for typed URLs / cross-origin referrals. We never
// point at /signup or /login because those pages redirect authed users back
// into onboarding — and we never point at /app/* because for a not-yet-done
// user those pages redirect back into onboarding too. So the only safe
// referer is the marketing landing or another non-onboarding, non-app page.
const referer = Astro.request.headers.get('referer');
let backHref = '/';
if (referer) {
  try {
    const refUrl = new URL(referer);
    if (refUrl.origin === Astro.url.origin
        && !refUrl.pathname.startsWith('/onboarding')
        && !refUrl.pathname.startsWith('/app')
        && !refUrl.pathname.startsWith('/signup')
        && !refUrl.pathname.startsWith('/login')
        && !refUrl.pathname.startsWith('/forgot-password')
        && !refUrl.pathname.startsWith('/api')) {
      backHref = refUrl.pathname + refUrl.search;
    }
  } catch {
    // Malformed referer — fall through to the default '/'.
  }
}
---
<BaseLayout title="Welcome" description="Let's set up your attendance tracking.">
  <div class="grid min-h-screen place-items-center px-4 py-8">
    <div class="w-full max-w-md">
      <div class="mb-6 flex items-center justify-between gap-2">
        <a
          href={backHref}
          class="inline-flex items-center gap-1 text-sm hover:underline"
          style="color: var(--color-text-muted);"
          data-astro-reload
          aria-label="Back"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back
        </a>
        <div class="flex items-center gap-2 font-semibold">
          <Logo class="h-7 w-7" />
          <span>Attendance Tracker</span>
        </div>
      </div>

      <div class="card">
        <div class="flex items-center gap-3">
          <Avatar name={user.name} image={user.image ?? null} seed={user.id} size={48} />
          <div>
            <p class="text-sm font-medium" style="color: var(--color-brand-600);" data-i18n="onboarding.welcome.step">Step 1 of 2</p>
            <h1 class="text-2xl font-semibold tracking-tight">Welcome, {user.name}.</h1>
          </div>
        </div>
        <p class="mt-3" style="color: var(--color-text-muted);" data-i18n="onboarding.welcome.body">
          Let's get your first session set up. It takes about two minutes.
        </p>

        <ol class="mt-5 space-y-3" style="color: var(--color-text-muted);">
          <li class="flex gap-3">
            <span class="num flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold" style="background-color: var(--color-brand-100); color: var(--color-brand-700);">1</span>
            <span data-i18n="onboarding.welcome.step1">Name your session and set the target percentage.</span>
          </li>
          <li class="flex gap-3">
            <span class="num flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold" style="background-color: var(--color-surface-2); color: var(--color-text-muted);">2</span>
            <span data-i18n="onboarding.welcome.step2">Add your weekly timetable (manual or paste-text).</span>
          </li>
        </ol>

        <a href="/onboarding/session" class="btn btn-primary mt-6 w-full text-center" data-i18n="onboarding.welcome.getStarted">Get started</a>
      </div>
    </div>
  </div>
</BaseLayout>
