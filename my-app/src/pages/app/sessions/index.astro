---
export const prerender = false;
import AppLayout from "../../../layouts/AppLayout.astro";
import PercentageBar from "../../../components/ui/PercentageBar.astro";
import {
  db,
  AcademicSession,
  Subject,
  AttendanceLog,
  Day,
  TimetableSlot,
  eq,
  desc,
} from "astro:db";
import {
  computeStats,
  overallStats,
  toDateString,
} from "../../../lib/attendance";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/app/sessions");

const sessions = await db
  .select()
  .from(AcademicSession)
  .where(eq(AcademicSession.userId, user.id))
  .orderBy(desc(AcademicSession.createdAt));

async function rollup(sess: typeof AcademicSession.$inferSelect) {
  const today = toDateString(new Date());

  const [subjRows, allLogs, dayOverrides, allSlots] = await Promise.all([
    db.select().from(Subject).where(eq(Subject.sessionId, sess.id)),
    db.select().from(AttendanceLog).where(eq(AttendanceLog.sessionId, sess.id)),
    db.select().from(Day).where(eq(Day.sessionId, sess.id)),
    db.select().from(TimetableSlot).where(eq(TimetableSlot.sessionId, sess.id)),
  ]);

  // Filter logs up to today for "current" attendance percentage
  const logs = allLogs.filter((l) => l.date <= today);

  const dayArr = dayOverrides.map((d) => ({
    date: d.date,
    status: d.status as "normal" | "holiday" | "sick" | "event",
  }));

  const jsDow = new Date().getDay(); // 0=Sun..6=Sat
  const subjectsWithRegularSlotToday = new Set(
    allSlots.filter((s) => s.dayOfWeek === jsDow).map((s) => s.subjectId),
  );

  const todaysCounts = new Map<
    string,
    { regular: number; absent: number; extra: number; off: boolean }
  >();
  for (const s of subjRows) {
    todaysCounts.set(s.id, { regular: 0, absent: 0, extra: 0, off: false });
  }
  for (const l of logs) {
    if (l.date !== today) continue;
    if (!todaysCounts.has(l.subjectId)) continue;
    const c = todaysCounts.get(l.subjectId)!;
    if (l.status === "present") c.regular += 1;
    else if (l.status === "absent") c.absent += 1;
    else if (l.status === "extra") c.extra += 1;
    else if (l.status === "off") c.off = true;
  }

  const perSubj: Record<string, ReturnType<typeof computeStats>> = {};
  for (const s of subjRows) {
    const sLogs = logs
      .filter((l: any) => l.subjectId === s.id)
      .map((l: any) => ({
        date: l.date,
        status: l.status as "present" | "absent" | "extra" | "off",
      }));
    const stats = computeStats(sLogs, dayArr, sess.targetPct);

    // If the session is active, apply default-absent logic for today's classes
    if (!sess.isArchived) {
      const hasRegularToday = subjectsWithRegularSlotToday.has(s.id);
      const counts = todaysCounts.get(s.id)!;
      const totalRows =
        counts.regular + counts.absent + counts.extra + (counts.off ? 1 : 0);
      if (hasRegularToday && totalRows === 0) {
        stats.held += 1;
        stats.pct = stats.held === 0 ? 0 : (stats.attended / stats.held) * 100;
      }
    }

    perSubj[s.id] = stats;
  }

  const filteredForOverall: Record<string, any> = {};
  const mode = sess.overallCalcMode;
  for (const s of subjRows) {
    const stats = perSubj[s.id]!;
    if (mode === "both") {
      filteredForOverall[s.id] = stats;
    } else if (mode === "lab") {
      if (s.isLab) filteredForOverall[s.id] = stats;
    } else {
      if (!s.isLab) filteredForOverall[s.id] = stats;
    }
  }

  return {
    overall: overallStats(filteredForOverall, sess.targetPct),
    subjects: subjRows.length,
  };
}
---

<AppLayout title="Sessions">
  <div class="mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-8">
    <div class="flex items-baseline justify-between">
      <h1
        class="text-2xl font-semibold tracking-tight"
        data-i18n="sessions.title"
      >
        Sessions
      </h1>
      <button
        id="new-session-btn"
        class="btn btn-primary btn-sm"
        data-i18n="sessions.newSession">+ New session</button
      >
    </div>

    {
      sessions.length === 0 ? (
        <p
          class="mt-6 text-sm"
          style="color: var(--color-text-subtle);"
          data-i18n="sessions.noSessions"
        >
          No sessions yet.
        </p>
      ) : (
        <ul class="mt-6 space-y-3">
          {await Promise.all(
            sessions.map(async (s) => {
              const r = await rollup(s);
              return (
                <li class="card">
                  <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <div>
                      <a
                        href={`/app/sessions/${s.id}`}
                        class="font-semibold hover:underline"
                      >
                        {s.name}
                      </a>
                      <div
                        class="text-xs num"
                        style="color: var(--color-text-subtle);"
                        data-i18n="sessions.detailLine"
                        data-i18n-params={JSON.stringify({
                          startDate: s.startDate,
                          endDate: s.endDate,
                          subjects: r.subjects,
                          target: s.targetPct,
                        })}
                      >
                        {s.startDate} → {s.endDate} · {r.subjects} subjects ·
                        target {s.targetPct}%
                        {s.isArchived && (
                          <span
                            class="ml-2 rounded px-1.5 py-0.5 text-[10px] uppercase"
                            style="background-color: var(--color-surface-2);"
                            data-i18n="sessions.labelArchived"
                          >
                            Archived
                          </span>
                        )}
                      </div>
                    </div>
                    <div class="num text-2xl font-semibold">
                      {r.overall.pct.toFixed(1)}%
                    </div>
                  </div>
                  <div class="mt-3">
                    <PercentageBar
                      pct={r.overall.pct}
                      target={s.targetPct}
                      size="sm"
                    />
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a
                      href={`/app/sessions/${s.id}`}
                      class="btn btn-secondary btn-sm"
                      data-i18n="sessions.viewRollup"
                    >
                      View rollup
                    </a>
                    {!s.isArchived && (
                      <form
                        method="post"
                        action={`/api/sessions/${s.id}/archive`}
                        onsubmit="const activeLocale = localStorage.getItem('at75_locale') || 'en'; const msgs = { en: 'Archive this session? You can still view its rollup.', hi: 'इस सत्र को आर्काइव करें? आप अभी भी इसके रोलअप को देख सकते हैं।', es: '¿Archivar esta sesión? Aún puedes ver su resumen.', fr: 'Archiver cette session ? Vous pouvez toujours voir son récapitulatif.', de: 'Diese Sitzung archivieren? Sie können immer noch die Zusammenfassung anzeigen.', pt: 'Arquivar esta sessão? Você ainda poderá ver o resumo.', ar: 'هل تريد أرشفة هذه الجلسة؟ لا يزال بإمكانك عرض ملخصها.', zh: '归档此学期？您仍然可以查看其汇总。', ja: 'このセッションをアーカイブしますか？ロールアップは引き続き表示できます。', ru: 'Архивировать эту сессию? Вы все еще сможете просматривать её сводку.' }; return confirm(msgs[activeLocale] || msgs.en);"
                      >
                        <button
                          type="submit"
                          class="btn btn-ghost btn-sm"
                          data-i18n="sessions.btnArchive"
                        >
                          Archive
                        </button>
                      </form>
                    )}
                  </div>
                </li>
              );
            }),
          )}
        </ul>
      )
    }
  </div>

  <dialog
    id="new-session-modal"
    class="rounded-xl border border-border bg-bg text-text p-6 max-w-md w-full shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-xs"
    style="margin: auto;"
  >
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <div
          class="flex size-10 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
            ></path>
          </svg>
        </div>
        <h2
          class="text-lg font-semibold leading-6"
          data-i18n="sessions.modal.title"
        >
          Reset session data?
        </h2>
      </div>

      <p
        class="text-sm font-normal"
        style="color: var(--color-text-muted);"
        data-i18n="sessions.modal.body"
      >
        Creating a new session will permanently erase all your current data,
        including active sessions, subjects, timetables, and attendance logs.
        This action cannot be undone.
      </p>

      <p id="reset-error-msg" class="text-xs text-red-600 font-medium hidden">
      </p>

      <div class="mt-2 flex justify-end gap-3">
        <button
          type="button"
          id="cancel-reset-btn"
          class="btn btn-secondary btn-sm"
          data-i18n="sessions.modal.cancel">Cancel</button
        >
        <button
          type="button"
          id="confirm-reset-btn"
          class="btn btn-danger btn-sm"
          data-i18n="sessions.modal.confirm">Continue and Reset</button
        >
      </div>
    </div>
  </dialog>
</AppLayout>

<script>
  import { resolveLocale, STORAGE_KEY, t } from "../../../lib/i18n";

  const getLocale = () => {
    try {
      return resolveLocale(localStorage.getItem(STORAGE_KEY));
    } catch {
      return "en";
    }
  };
  const tr = (key: string) => t(getLocale(), key);

  const newSessionBtn = document.getElementById("new-session-btn");
  const modal = document.getElementById(
    "new-session-modal",
  ) as HTMLDialogElement | null;
  const cancelBtn = document.getElementById("cancel-reset-btn");
  const confirmBtn = document.getElementById("confirm-reset-btn");
  const errorMsg = document.getElementById("reset-error-msg");

  if (newSessionBtn && modal && cancelBtn && confirmBtn) {
    newSessionBtn.addEventListener("click", (e) => {
      e.preventDefault();
      if (errorMsg) {
        errorMsg.classList.add("hidden");
        errorMsg.textContent = "";
      }
      modal.showModal();
    });

    cancelBtn.addEventListener("click", () => {
      modal.close();
    });

    // Close on clicking backdrop
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        modal.close();
      }
    });

    confirmBtn.addEventListener("click", async () => {
      if (errorMsg) {
        errorMsg.classList.add("hidden");
        errorMsg.textContent = "";
      }
      confirmBtn.setAttribute("disabled", "true");
      const originalText = confirmBtn.textContent;
      confirmBtn.textContent = tr("sessions.modal.resetting");

      try {
        const res = await fetch("/api/sessions/reset", {
          method: "POST",
        });
        if (res.ok) {
          window.location.href = "/onboarding/welcome";
        } else {
          const body = (await res.json().catch(() => null)) as any;
          const msg = body?.error?.message || tr("sessions.modal.errorReset");
          if (errorMsg) {
            errorMsg.textContent = msg;
            errorMsg.classList.remove("hidden");
          }
          confirmBtn.removeAttribute("disabled");
          confirmBtn.textContent = originalText;
        }
      } catch (err) {
        console.error(err);
        if (errorMsg) {
          errorMsg.textContent = tr("error.generic");
          errorMsg.classList.remove("hidden");
        }
        confirmBtn.removeAttribute("disabled");
        confirmBtn.textContent = originalText;
      }
    });
  }
</script>
