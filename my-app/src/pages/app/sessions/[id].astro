---
export const prerender = false;
import AppLayout from "../../../layouts/AppLayout.astro";
import PercentageBar from "../../../components/ui/PercentageBar.astro";
import Stat from "../../../components/ui/Stat.astro";
import {
  db,
  AcademicSession,
  Subject,
  AttendanceLog,
  Day,
  TimetableSlot,
  eq,
  and,
} from "astro:db";
import {
  computeStats,
  overallStats,
  toDateString,
} from "../../../lib/attendance";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/app/sessions");

const sessId = Astro.params.id!;
const sess = (
  await db
    .select()
    .from(AcademicSession)
    .where(
      and(eq(AcademicSession.id, sessId), eq(AcademicSession.userId, user.id)),
    )
    .limit(1)
)[0];
if (!sess) return Astro.redirect("/app/sessions");

const today = toDateString(new Date());

const [subjRows, allLogs, dayOverrides, allSlots] = await Promise.all([
  db.select().from(Subject).where(eq(Subject.sessionId, sess.id)),
  db.select().from(AttendanceLog).where(eq(AttendanceLog.sessionId, sess.id)),
  db.select().from(Day).where(eq(Day.sessionId, sess.id)),
  db.select().from(TimetableSlot).where(eq(TimetableSlot.sessionId, sess.id)),
]);

const logs = allLogs.filter((l) => l.date <= today);

const dayArr = dayOverrides.map((d) => ({
  date: d.date,
  status: d.status as "normal" | "holiday" | "sick" | "event",
}));

const jsDow = new Date().getDay(); 
const subjectsWithRegularSlotToday = new Set(
  allSlots.filter((s) => s.dayOfWeek === jsDow).map((s) => s.subjectId),
);

const todaysCounts = new Map<
  string,
  { regular: number; absent: number; extra: number; off: boolean }
>();
for (const s of subjRows) {
  todaysCounts.set(s.id, { regular: 0, absent: 0, extra: 0, off: false });
}
for (const l of logs) {
  if (l.date !== today) continue;
  if (!todaysCounts.has(l.subjectId)) continue;
  const c = todaysCounts.get(l.subjectId)!;
  if (l.status === "present") c.regular += 1;
  else if (l.status === "absent") c.absent += 1;
  else if (l.status === "extra") c.extra += 1;
  else if (l.status === "off") c.off = true;
}

const perSubject: Record<
  string,
  {
    name: string;
    color: string;
    isLab: boolean;
    stats: ReturnType<typeof computeStats>;
  }
> = {};
for (const s of subjRows) {
  const sLogs = logs
    .filter((l: any) => l.subjectId === s.id)
    .map((l: any) => ({
      date: l.date,
      status: l.status as "present" | "absent" | "extra" | "off",
    }));
  const stats = computeStats(sLogs, dayArr, sess.targetPct);

  
  const hasRegularToday = subjectsWithRegularSlotToday.has(s.id);
  const counts = todaysCounts.get(s.id)!;
  const totalRows =
    counts.regular + counts.absent + counts.extra + (counts.off ? 1 : 0);
  if (hasRegularToday && totalRows === 0) {
    stats.held += 1;
    stats.pct = stats.held === 0 ? 0 : (stats.attended / stats.held) * 100;
  }

  perSubject[s.id] = { name: s.name, color: s.color, isLab: s.isLab, stats };
}

const mode = sess.overallCalcMode;
const filteredForOverall: Record<string, any> = {};
for (const [id, item] of Object.entries(perSubject)) {
  if (mode === "both") {
    filteredForOverall[id] = item.stats;
  } else if (mode === "lab") {
    if (item.isLab) filteredForOverall[id] = item.stats;
  } else {
    if (!item.isLab) filteredForOverall[id] = item.stats;
  }
}
const overall = overallStats(filteredForOverall, sess.targetPct);
const daysCount = logs.length > 0 ? new Set(logs.map((l) => l.date)).size : 0;
---

<AppLayout title={sess.name}>
  <div class="min-h-screen w-full px-4 py-4 sm:px-8 sm:py-8">
    <nav class="text-sm" style="color: var(--color-text-subtle);">
      <a href="/app/sessions" class="hover:underline" data-i18n="sessions.title"
        >Sessions</a
      >
      <span aria-hidden="true">/</span>
      <span>{sess.name}</span>
    </nav>

    <div class="mt-3 flex flex-wrap items-baseline justify-between gap-3">
      <h1 class="text-2xl font-semibold tracking-tight">{sess.name}</h1>
    </div>

    <p
      class="num mt-1 text-sm"
      style="color: var(--color-text-subtle);"
      data-i18n="sessions.detailLine"
      data-i18n-params={JSON.stringify({
        startDate: sess.startDate,
        endDate: sess.endDate,
        subjects: subjRows.length,
        target: sess.targetPct,
      })}
    >
      {sess.startDate} → {sess.endDate} · {subjRows.length} subjects · target {
        sess.targetPct
      }%
    </p>

    <div class="mt-4 card">
      <div class="flex items-baseline justify-between">
        <div>
          <div
            class="text-xs uppercase tracking-wide"
            style="color: var(--color-text-subtle);"
            data-i18n="sessionDetail.overallAttendance"
          >
            Overall Attendance Till Date
          </div>
          <div class="num text-3xl font-semibold">
            {overall.pct.toFixed(1)}%
          </div>
        </div>
        <div
          class="text-right num text-sm"
          style="color: var(--color-text-subtle);"
          data-i18n="sessionDetail.overallCounts"
          data-i18n-params={JSON.stringify({
            attended: overall.attended,
            held: overall.held,
            days: daysCount,
          })}
        >
          {overall.attended} / {overall.held} · {daysCount} days
        </div>
      </div>
      <div class="mt-3">
        <PercentageBar pct={overall.pct} target={sess.targetPct} />
      </div>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <Stat
        label="Subjects tracked"
        value={subjRows.length}
        i18nKey="sessionDetail.stat.subjectsTracked"
      />
      <Stat
        label="Day overrides"
        value={dayOverrides.length}
        i18nKey="sessionDetail.stat.dayOverrides"
      />
      <Stat
        label="Logs total"
        value={logs.length}
        i18nKey="sessionDetail.stat.logsTotal"
      />
    </div>

    <h2 class="mt-10 text-lg font-semibold" data-i18n="sessionDetail.bySubject">
      By subject
    </h2>
    {
      subjRows.length === 0 ? (
        <p
          class="mt-2 text-sm"
          style="color: var(--color-text-subtle);"
          data-i18n="sessionDetail.noSubjects"
        >
          No subjects in this session.
        </p>
      ) : (
        <ul class="mt-3 space-y-2">
          {subjRows.map((s) => {
            const item = perSubject[s.id]!;
            return (
              <li class="card flex items-center gap-3">
                <span
                  aria-hidden="true"
                  style={`width: 4px; align-self: stretch; border-radius: 4px; background-color: ${s.color};`}
                />
                <div class="flex-1">
                  <div class="flex items-baseline gap-2">
                    <a
                      href={`/app/subjects/${s.id}`}
                      class="font-medium hover:underline"
                    >
                      {s.name}
                    </a>
                    {s.code && (
                      <span
                        class="text-xs"
                        style="color: var(--color-text-subtle);"
                      >
                        {s.code}
                      </span>
                    )}
                    {s.isLab && (
                      <span
                        class="rounded px-1.5 py-0.5 text-[9px] font-medium uppercase"
                        style="background-color: var(--color-surface-2); color: var(--color-text-subtle);"
                        data-i18n="subjects.labelLab"
                      >
                        Lab
                      </span>
                    )}
                  </div>
                  <div class="mt-1">
                    <PercentageBar
                      pct={item.stats.pct}
                      target={sess.targetPct}
                      size="sm"
                    />
                  </div>
                </div>
                <div class="text-right">
                  <div class="num text-xl font-semibold">
                    {item.stats.pct.toFixed(1)}%
                  </div>
                  <div class="text-xs" style="color: var(--color-text-subtle);">
                    {item.stats.attended}/{item.stats.held}
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</AppLayout>
