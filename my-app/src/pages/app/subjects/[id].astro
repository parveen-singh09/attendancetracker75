---
export const prerender = false;
import AppLayout from "../../../layouts/AppLayout.astro";
import PercentageBar from "../../../components/ui/PercentageBar.astro";
import WhatIfSimulator from "../../../components/attendance/WhatIfSimulator";
import {
  db,
  AcademicSession,
  Subject,
  AttendanceLog,
  Day,
  TimetableSlot,
  eq,
  and,
  desc,
  lte,
} from "astro:db";
import {
  computeStats,
  toDateString,
  addDays,
  backfillAbsences,
} from "../../../lib/attendance";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/app/subjects");

const subjectId = Astro.params.id!;
const sess = (
  await db
    .select()
    .from(AcademicSession)
    .where(
      and(
        eq(AcademicSession.userId, user.id),
        eq(AcademicSession.isArchived, false),
      ),
    )
    .orderBy(desc(AcademicSession.createdAt))
    .limit(1)
)[0];
if (!sess) return Astro.redirect("/onboarding/session");

const subj = (
  await db.select().from(Subject).where(eq(Subject.id, subjectId)).limit(1)
)[0];
if (!subj || subj.sessionId !== sess.id) return Astro.redirect("/app/subjects");

const today = toDateString(new Date());
const jsDow = new Date().getDay(); 

const [logs, dayOverrides, allSubjSlots] = await Promise.all([
  db
    .select()
    .from(AttendanceLog)
    .where(
      and(
        eq(AttendanceLog.subjectId, subjectId),
        lte(AttendanceLog.date, today),
      ),
    ),
  db.select().from(Day).where(eq(Day.sessionId, sess.id)),
  db
    .select()
    .from(TimetableSlot)
    .where(eq(TimetableSlot.subjectId, subjectId)),
]);

const slotsToday = allSubjSlots.filter((s) => s.dayOfWeek === jsDow);
const slotDows = allSubjSlots.map((s) => s.dayOfWeek);
const yesterday = toDateString(addDays(new Date(), -1));

const dayArr = dayOverrides.map((d) => ({
  date: d.date,
  status: d.status as "normal" | "holiday" | "sick" | "event",
}));
const logArr = logs.map((l) => ({
  date: l.date,
  status: l.status as "present" | "absent" | "extra" | "off",
}));

const backfilled = backfillAbsences(
  logArr,
  slotDows,
  dayArr,
  sess.startDate,
  yesterday,
);

const hasRegularToday = slotsToday.length > 0;
const totalRows = logs.filter((l) => l.date === today).length;
if (hasRegularToday && totalRows === 0) {
  backfilled.push({ date: today, status: "absent" });
}

const stats = computeStats(backfilled, dayArr, sess.targetPct);

const recent = [...logs]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 14);
---

<AppLayout title={subj.name}>
  <div class="min-h-screen w-full px-4 py-4 sm:px-8 sm:py-8">
    <nav class="text-sm" style="color: var(--color-text-subtle);">
      <a href="/app/subjects" class="hover:underline" data-i18n="subjects.title"
        >Subjects</a
      >
      <span aria-hidden="true">/</span>
      <span>{subj.name}</span>
    </nav>

    <div class="mt-3 flex items-center gap-3">
      <span
        aria-hidden="true"
        style={`width: 8px; height: 32px; border-radius: 4px; background-color: ${subj.color};`}
      ></span>
      <h1 class="text-2xl font-semibold tracking-tight">{subj.name}</h1>
      {
        subj.code && (
          <span class="text-sm" style="color: var(--color-text-subtle);">
            {subj.code}
          </span>
        )
      }
    </div>

    <div class="card mt-5">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <div>
          <div
            class="text-xs uppercase tracking-wide"
            style="color: var(--color-text-subtle);"
            data-i18n="subjectDetail.stat.attendance"
          >
            Attendance
          </div>
          <div class="num text-4xl font-semibold">{stats.pct.toFixed(1)}%</div>
          <div
            class="text-sm"
            style="color: var(--color-text-subtle);"
            data-i18n="subjectDetail.stat.attendedCount"
            data-i18n-params={JSON.stringify({
              attended: stats.attended,
              held: stats.held,
            })}
          >
            {stats.attended} of {stats.held} classes attended
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3 text-right sm:flex sm:gap-6">
          <div>
            <div class="num text-2xl font-semibold">{stats.canMiss}</div>
            <div
              class="text-[10px] uppercase"
              style="color: var(--color-text-subtle);"
              data-i18n="subjectDetail.stat.canMiss"
            >
              Can miss
            </div>
          </div>
          <div>
            <div class="num text-2xl font-semibold">{stats.mustAttend}</div>
            <div
              class="text-[10px] uppercase"
              style="color: var(--color-text-subtle);"
              data-i18n="subjectDetail.stat.needToAttend"
            >
              Need to attend
            </div>
          </div>
        </div>
      </div>
      <div class="mt-4">
        <PercentageBar pct={stats.pct} target={sess.targetPct} />
      </div>
    </div>

    <div class="mt-6">
      <WhatIfSimulator client:load base={stats} target={sess.targetPct} />
    </div>

    <h2
      class="mt-10 text-lg font-semibold"
      data-i18n="subjectDetail.recentLogs"
    >
      Recent logs
    </h2>
    {
      recent.length === 0 ? (
        <p
          class="mt-2 text-sm"
          style="color: var(--color-text-subtle);"
          data-i18n="subjectDetail.noLogsYet"
        >
          No logs yet. Mark today on the Today page.
        </p>
      ) : (
        <ul class="mt-3 space-y-1">
          {recent.map((l) => (
            <li class="card flex items-center justify-between py-2 text-sm">
              <span class="num">{l.date}</span>
              <span
                class="font-medium"
                style={`color: ${l.status === "present" ? "var(--color-safe)" : l.status === "absent" ? "var(--color-danger)" : "var(--color-text-subtle)"};`}
                data-i18n={`status.${l.status}`}
              >
                {l.status}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</AppLayout>
