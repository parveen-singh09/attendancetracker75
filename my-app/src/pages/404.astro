---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Page not found"
  description="The page you're looking for doesn't exist. Head back home or pick a starting point from the list below."
  keywords=""
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24 text-center">
    <p class="num text-7xl font-semibold tracking-tight sm:text-8xl" style="color: var(--color-brand-600);" aria-hidden="true">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-3 text-base sm:text-lg" style="color: var(--color-text-muted);">
      We couldn't find what you were looking for. The link may be broken, or the page may have moved.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn btn-primary">Go home</a>
      <a href="/app/today" class="btn btn-secondary">Open dashboard</a>
      <a href="/contact" class="btn btn-ghost">Report a broken link</a>
    </div>

    <div class="mt-12 grid gap-3 sm:grid-cols-2 text-left">
      <a href="/app/today" class="card p-4 hover:underline">
        <div class="text-sm font-semibold">Today</div>
        <div class="text-xs" style="color: var(--color-text-muted);">Log today's classes in 30 seconds.</div>
      </a>
      <a href="/app/calculator" class="card p-4 hover:underline">
        <div class="text-sm font-semibold">Bunk calculator</div>
        <div class="text-xs" style="color: var(--color-text-muted);">See how many classes you can miss per subject.</div>
      </a>
      <a href="/app/subjects" class="card p-4 hover:underline">
        <div class="text-sm font-semibold">Subjects</div>
        <div class="text-xs" style="color: var(--color-text-muted);">Manage subjects and target percentages.</div>
      </a>
      <a href="/contact" class="card p-4 hover:underline">
        <div class="text-sm font-semibold">Contact</div>
        <div class="text-xs" style="color: var(--color-text-muted);">Stuck on something? Send us a message.</div>
      </a>
    </div>
  </section>
</MarketingLayout>
