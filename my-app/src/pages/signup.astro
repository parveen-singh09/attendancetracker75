---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---
<BaseLayout title="Sign up" description="Create a free Attendance Tracker account.">
  <div class="auth-shell">
    <!-- Left: brand / value panel -->
    <aside class="auth-brand" aria-hidden="true">
      <div class="auth-brand-inner">
        <a href="/" class="auth-brand-logo">
          <Logo class="h-8 w-8" />
          <span>Attendance Tracker</span>
        </a>

        <div class="auth-brand-pitch">
          <h2>Free. Forever.</h2>
          <p>
            Join in under a minute. Add your timetable, log today's classes, and stay
            above the 75% rule without ever touching a spreadsheet.
          </p>
        </div>

        <ul class="auth-brand-points">
          <li>
            <span class="auth-brand-check" style="background-color: color-mix(in oklab, var(--color-safe) 18%, transparent); color: var(--color-safe);">✓</span>
            <div>
              <div class="auth-brand-point-title">Daily habit loop</div>
              <div class="auth-brand-point-body">Open the app, see today's classes, tap one button. Done.</div>
            </div>
          </li>
          <li>
            <span class="auth-brand-check" style="background-color: color-mix(in oklab, var(--color-safe) 18%, transparent); color: var(--color-safe);">✓</span>
            <div>
              <div class="auth-brand-point-title">Subject-wise math</div>
              <div class="auth-brand-point-body">Per-subject percentage and a weighted overall.</div>
            </div>
          </li>
          <li>
            <span class="auth-brand-check" style="background-color: color-mix(in oklab, var(--color-safe) 18%, transparent); color: var(--color-safe);">✓</span>
            <div>
              <div class="auth-brand-point-title">Session-based</div>
              <div class="auth-brand-point-body">One "Fall 2026", one "Spring 2027". Archive the rest.</div>
            </div>
          </li>
        </ul>

        <div class="auth-brand-foot">
          <span aria-hidden="true">🎓</span>
          Built for everyone.
        </div>
      </div>
    </aside>

    <!-- Right: form panel -->
    <section class="auth-form-wrap">
      <div class="auth-form-top">
        <a href="/" class="auth-form-back" aria-label="Back to home">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span class="hidden xs:inline">Back</span>
        </a>
        <a href="/" class="auth-form-logo" aria-label="Home">
          <Logo class="h-7 w-7" />
          <span class="hidden sm:inline">Attendance Tracker</span>
        </a>
      </div>

      <div class="auth-card card">
        <header class="auth-head">
          <h1 data-i18n="auth.signup.title">Create your account</h1>
          <p data-i18n="auth.signup.subtitle">Start tracking in under a minute.</p>
        </header>

        <form id="signup-form" class="auth-form" novalidate>
          <div class="field">
            <label for="name" class="field-label" data-i18n="auth.signup.nameLabel">Full name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="e.g. John Doe"
              class="input"
              data-i18n-attr="placeholder:auth.signup.namePlaceholder"
            />
          </div>

          <div class="field">
            <label for="email" class="field-label" data-i18n="auth.signup.emailLabel">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="input"
              data-i18n-attr="placeholder:auth.signup.emailPlaceholder"
            />
          </div>

          <div class="field">
            <label for="password" class="field-label" data-i18n="auth.signup.passwordLabel">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              class="input"
              data-i18n-attr="placeholder:auth.signup.passwordPlaceholder"
            />
            <p class="field-hint" data-i18n="auth.signup.passwordHint">Minimum 8 characters. Use a mix of letters and numbers.</p>
          </div>

          <div id="form-error" class="auth-error" role="alert" hidden></div>

          <button id="submit-btn" type="button" class="btn btn-primary auth-submit" data-i18n="btn.createAccount">
            Create account
          </button>

          <div class="auth-divider">
            <span>or</span>
          </div>

          <a href="/api/auth/google/login" class="btn btn-secondary flex items-center justify-center gap-2 w-full" style="text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05" />
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335" />
            </svg>
            <span>Continue with Google</span>
          </a>
        </form>

        <p class="auth-foot">
          <span data-i18n="auth.signup.haveAccount">Already have an account?</span>
          <a href="/login" class="auth-link auth-link-strong" data-i18n="auth.signup.logIn">Log in</a>
        </p>

        <p class="auth-legal">
          <span data-i18n="auth.signup.legal">By creating an account, you agree to our</span>
          <a href="/legal/terms" class="auth-link" data-i18n="auth.signup.terms">Terms</a> <span data-i18n="auth.signup.and">and</span>
          <a href="/legal/privacy" class="auth-link" data-i18n="auth.signup.privacy">Privacy Policy</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .auth-shell {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .auth-brand {
    display: none;
    background:
      radial-gradient(1200px 600px at 0% 0%, color-mix(in oklab, var(--color-brand-400) 35%, transparent), transparent 60%),
      radial-gradient(900px 500px at 100% 100%, color-mix(in oklab, var(--color-brand-700) 60%, transparent), transparent 60%),
      linear-gradient(135deg, var(--color-brand-600) 0%, var(--color-brand-800) 100%);
    color: white;
  }
  .auth-brand-inner {
    position: relative;
    height: 100%;
    padding: 3rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 36rem;
  }
  .auth-brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: white;
    font-weight: 600;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .auth-brand-logo :global(svg) { color: white; }
  .auth-brand-pitch h2 {
    font-size: clamp(1.75rem, 2.2vw + 0.5rem, 2.5rem);
    line-height: 1.15;
    font-weight: 600;
    color: white;
    margin: 0;
  }
  .auth-brand-pitch p {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 32rem;
  }
  .auth-brand-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .auth-brand-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .auth-brand-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .auth-brand-point-title {
    font-weight: 600;
    color: white;
    font-size: 0.9375rem;
  }
  .auth-brand-point-body {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
  }
  .auth-brand-foot {
    margin-top: auto;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .auth-form-wrap {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.25rem;
    background-color: var(--color-bg);
  }
  .auth-form-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    flex-wrap: nowrap;
  }
  .auth-form-back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    transition: color 150ms ease, background-color 150ms ease;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .auth-form-back:hover {
    color: var(--color-text);
    background-color: color-mix(in oklab, var(--color-text) 5%, transparent);
  }
  .auth-form-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .auth-form-wrap { padding: 3rem 2rem; }
  }

  .auth-card {
    width: 100%;
    max-width: 26rem;
    margin: 0 auto;
    padding: 1.75rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 8px 24px -12px rgb(0 0 0 / 0.12);
  }
  @media (min-width: 640px) {
    .auth-card { padding: 2rem; }
  }

  .auth-head h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .auth-head p {
    margin: 0.375rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .auth-form {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .auth-link {
    color: var(--color-brand-600);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
  }
  .auth-link:hover { text-decoration: underline; }
  .auth-link-strong { font-weight: 600; }

  .auth-error {
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    background-color: color-mix(in oklab, var(--color-danger) 10%, transparent);
    color: var(--color-danger);
    border: 1px solid color-mix(in oklab, var(--color-danger) 30%, transparent);
    font-size: 0.8125rem;
  }
  .auth-error[hidden] { display: none; }

  .auth-submit { width: 100%; }
  .auth-submit:disabled { opacity: 0.7; }

  .auth-divider {
    margin: 1.25rem 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-subtle);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .auth-divider::before,
  .auth-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .auth-foot {
    margin-top: 1.25rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .auth-legal {
    margin-top: 0.875rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    line-height: 1.5;
  }

  @media (min-width: 1024px) {
    .auth-shell { grid-template-columns: 1.05fr 1fr; }
    .auth-brand { display: block; }
    .auth-form-wrap { padding: 3rem 3.5rem; }
  }
</style>

<script>
  import { authClient } from '../lib/auth-client';
  import { t, STORAGE_KEY, resolveLocale, type Locale } from '../lib/i18n';

  const form = document.getElementById('signup-form') as HTMLFormElement;
  const errorDiv = document.getElementById('form-error') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const next = new URLSearchParams(window.location.search).get('next') || '/onboarding/welcome';

  // Re-read the locale every time we need to translate a string, so
  // the user changing languages mid-flow sees the new copy.
  const currentLocale = (): Locale => {
    try { return resolveLocale(localStorage.getItem(STORAGE_KEY)); }
    catch { return 'en'; }
  };
  const tr = (key: string): string => t(currentLocale(), key);

  // Smart landing: respect an explicit `?next=`, otherwise route
  // brand-new users to onboarding and completed users to the dashboard.
  const resolveDestination = async (): Promise<string> => {
    if (next && next !== '/signup' && next !== '/login') return next;
    try {
      const res = await fetch('/api/auth/get-session', { credentials: 'same-origin' });
      if (res.ok) {
        const body = (await res.json()) as { user?: { onboardingStep?: string } };
        if (body.user?.onboardingStep && body.user.onboardingStep !== 'done') {
          return '/onboarding/welcome';
        }
      }
    } catch {
      // fall through
    }
    return next || '/onboarding/welcome';
  };

  const setError = (msg: string) => {
    errorDiv.textContent = msg;
    errorDiv.hidden = false;
  };
  const clearError = () => {
    errorDiv.textContent = '';
    errorDiv.hidden = true;
  };
  const setSubmitting = (btn: HTMLButtonElement, submitting: boolean, label: string) => {
    btn.disabled = submitting;
    btn.textContent = submitting ? tr('btn.pleaseWait') : label;
  };

  form?.addEventListener('submit', (e) => e.preventDefault());

  submitBtn?.addEventListener('click', async () => {
    clearError();
    setSubmitting(submitBtn, true, tr('btn.createAccount'));

    const formData = new FormData(form);
    const name = (formData.get('name') as string).trim();
    const email = (formData.get('email') as string).trim();
    const password = formData.get('password') as string;

    if (password.length < 8) {
      setError(tr('auth.signup.error.shortPassword'));
      setSubmitting(submitBtn, false, tr('btn.createAccount'));
      return;
    }

    try {
      const { data, error } = await authClient.signUp({ email, password, name });

      if (error) {
        setError(error.message || tr('auth.signup.error.generic'));
        setSubmitting(submitBtn, false, tr('btn.createAccount'));
        return;
      }
      if (data) {
        const dest = await resolveDestination();
        window.location.href = dest;
      } else {
        setError(tr('auth.signup.error.generic'));
        setSubmitting(submitBtn, false, tr('btn.createAccount'));
      }
    } catch (err) {
      console.error('[signup] failed', err);
      setError(tr('error.network'));
      setSubmitting(submitBtn, false, tr('btn.createAccount'));
    }
  });
</script>
