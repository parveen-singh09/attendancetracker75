---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---
<BaseLayout title="Reset password" description="Reset your Attendance Tracker password.">
  <div class="auth-shell">
    <aside class="auth-brand" aria-hidden="true">
      <div class="auth-brand-inner">
        <a href="/" class="auth-brand-logo">
          <Logo class="h-8 w-8" />
          <span>Attendance Tracker</span>
        </a>

        <div class="auth-brand-pitch">
          <h2>Need to get back in?</h2>
          <p>
            Password reset is on the way. For now, the easiest way back in is to
            create a new account — it only takes a minute.
          </p>
        </div>

        <div class="auth-brand-foot">
          <span aria-hidden="true">🎓</span>
          Built for the 75% rule.
        </div>
      </div>
    </aside>

    <section class="auth-form-wrap">
      <a href="/" class="auth-form-logo" aria-label="Home">
        <Logo class="h-7 w-7" />
        <span>Attendance Tracker</span>
      </a>

      <div class="auth-card card">
        <header class="auth-head">
          <h1>Reset password</h1>
          <p>Password reset is coming soon.</p>
        </header>

        <div class="auth-info">
          For now, please create a new account or contact support if you're locked out.
        </div>

        <div class="auth-actions">
          <a class="btn btn-primary" href="/signup">Create account</a>
          <a class="btn btn-secondary" href="/login">Back to log in</a>
        </div>

        <p class="auth-foot">
          Need help? <a href="/about" class="auth-link auth-link-strong">Contact us</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .auth-shell {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .auth-brand {
    display: none;
    background:
      radial-gradient(1200px 600px at 0% 0%, color-mix(in oklab, var(--color-brand-400) 35%, transparent), transparent 60%),
      radial-gradient(900px 500px at 100% 100%, color-mix(in oklab, var(--color-brand-700) 60%, transparent), transparent 60%),
      linear-gradient(135deg, var(--color-brand-600) 0%, var(--color-brand-800) 100%);
    color: white;
  }
  .auth-brand-inner {
    position: relative;
    height: 100%;
    padding: 3rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 36rem;
  }
  .auth-brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: white;
    font-weight: 600;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .auth-brand-logo :global(svg) { color: white; }
  .auth-brand-pitch h2 {
    font-size: clamp(1.75rem, 2.2vw + 0.5rem, 2.5rem);
    line-height: 1.15;
    font-weight: 600;
    color: white;
    margin: 0;
  }
  .auth-brand-pitch p {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 32rem;
  }
  .auth-brand-foot {
    margin-top: auto;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .auth-form-wrap {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.25rem;
    background-color: var(--color-bg);
  }
  .auth-form-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 1.75rem;
    align-self: flex-start;
  }
  @media (min-width: 640px) {
    .auth-form-wrap { padding: 3rem 2rem; }
  }

  .auth-card {
    width: 100%;
    max-width: 26rem;
    margin: 0 auto;
    padding: 1.75rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 8px 24px -12px rgb(0 0 0 / 0.12);
  }
  @media (min-width: 640px) {
    .auth-card { padding: 2rem; }
  }

  .auth-head h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .auth-head p {
    margin: 0.375rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .auth-info {
    margin-top: 1.5rem;
    padding: 0.75rem 0.875rem;
    border-radius: 0.5rem;
    background-color: color-mix(in oklab, var(--color-brand-500) 10%, transparent);
    color: var(--color-text);
    border: 1px solid color-mix(in oklab, var(--color-brand-500) 25%, transparent);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .auth-actions {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  @media (min-width: 480px) {
    .auth-actions { flex-direction: row; }
  }
  .auth-actions .btn { flex: 1; }

  .auth-foot {
    margin-top: 1.25rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .auth-link {
    color: var(--color-brand-600);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
  }
  .auth-link:hover { text-decoration: underline; }
  .auth-link-strong { font-weight: 600; }

  @media (min-width: 1024px) {
    .auth-shell { grid-template-columns: 1.05fr 1fr; }
    .auth-brand { display: block; }
    .auth-form-wrap { padding: 3rem 3.5rem; }
  }
</style>
