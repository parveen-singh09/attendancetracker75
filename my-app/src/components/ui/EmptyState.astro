---
interface Props {
  title: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  titleKey?: string;
  descriptionKey?: string;
  ctaLabelKey?: string;
}
const { title, description, ctaLabel, ctaHref, titleKey, descriptionKey, ctaLabelKey } = Astro.props;
---
<div class="card flex flex-col items-center gap-3 py-12 text-center">
  <div class="text-4xl" aria-hidden="true">📓</div>
  <h2 class="text-lg font-semibold" data-i18n={titleKey}>{title}</h2>
  {description && <p class="max-w-md text-sm" style="color: var(--color-text-subtle);" data-i18n={descriptionKey}>{description}</p>}
  {ctaLabel && ctaHref && <a href={ctaHref} class="btn btn-primary mt-2" data-i18n={ctaLabelKey}>{ctaLabel}</a>}
</div>
