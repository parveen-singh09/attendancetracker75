---
interface Props {
  title: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const { title, description, ctaLabel, ctaHref } = Astro.props;
---
<div class="card flex flex-col items-center gap-3 py-12 text-center">
  <div class="text-4xl" aria-hidden="true">📓</div>
  <h2 class="text-lg font-semibold">{title}</h2>
  {description && <p class="max-w-md text-sm" style="color: var(--color-text-subtle);">{description}</p>}
  {ctaLabel && ctaHref && <a href={ctaHref} class="btn btn-primary mt-2">{ctaLabel}</a>}
</div>
