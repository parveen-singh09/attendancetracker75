---
interface Props {
  label: string;
  value: string | number;
  hint?: string;
  tone?: 'safe' | 'warn' | 'danger' | 'neutral';
  id?: string;
}
const { label, value, hint, tone = 'neutral', id } = Astro.props;
const toneColor =
  tone === 'safe' ? 'var(--color-safe)' :
  tone === 'warn' ? 'var(--color-warn)' :
  tone === 'danger' ? 'var(--color-danger)' :
  'var(--color-text)';
---
<span class="card flex flex-col gap-0.5 py-2.5 px-3.5">
  <span class="text-[10px] uppercase tracking-wide" style="color: var(--color-text-subtle);">{label}</span>
  <span id={id} class="num text-2xl font-semibold leading-tight" style={`color: ${toneColor};`}>{value}</span>
  {hint && <span class="text-xs" style="color: var(--color-text-subtle);">{hint}</span>}
</span>
