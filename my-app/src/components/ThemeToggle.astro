---
// Theme toggle icon button.
---
<button
  type="button"
  aria-label="Toggle color theme"
  class="theme-toggle-btn cursor-pointer p-1 transition-colors hover:text-brand-600 focus:outline-none"
  title="Toggle theme"
>
  <svg class="sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <svg class="moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
  </svg>
</button>

<style>
  .theme-toggle-btn {
    background: transparent;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }
  .theme-toggle-btn:hover {
    color: var(--color-brand-600);
  }
  .theme-toggle-btn .moon { display: none; }
  :global(html.dark) .theme-toggle-btn .sun { display: none; }
  :global(html.dark) .theme-toggle-btn .moon { display: block; }
</style>
