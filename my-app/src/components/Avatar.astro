---
import { avatarColor, initials } from '../lib/avatar';

interface Props {
  name: string;
  image?: string | null;
  seed?: string; 
  size?: number; 
}

const { name, image, seed, size = 40 } = Astro.props;
const color = avatarColor(seed ?? name);
const text = initials(name);
const fontSize = Math.round(size * 0.42);
const radius = size / 2;
---
{image ? (
  <img
    src={image}
    alt={`${name}'s avatar`}
    width={size}
    height={size}
    class="avatar"
    style={`width: ${size}px; height: ${size}px; border-radius: ${radius}px; object-fit: cover; flex-shrink: 0;`}
  />
) : (
  <span
    role="img"
    aria-label={`${name}'s avatar`}
    class="avatar num"
    style={`
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: ${size}px;
      height: ${size}px;
      border-radius: ${radius}px;
      background-color: ${color};
      color: white;
      font-weight: 600;
      font-size: ${fontSize}px;
      line-height: 1;
      flex-shrink: 0;
      user-select: none;
    `}
  >
    {text}
  </span>
)}
