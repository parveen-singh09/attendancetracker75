---

import { t as translate } from '../../lib/i18n';

const faqKeys: { qKey: string; aKey: string }[] = [
  { qKey: 'faq.q1', aKey: 'faq.a1' },
  { qKey: 'faq.q2', aKey: 'faq.a2' },
  { qKey: 'faq.q3', aKey: 'faq.a3' },
  { qKey: 'faq.q4', aKey: 'faq.a4' },
  { qKey: 'faq.q5', aKey: 'faq.a5' },
  { qKey: 'faq.q6', aKey: 'faq.a6' },
  { qKey: 'faq.q7', aKey: 'faq.a7' },
  { qKey: 'faq.q8', aKey: 'faq.a8' },
  { qKey: 'faq.q9', aKey: 'faq.a9' },
  { qKey: 'faq.q10', aKey: 'faq.a10' },
  { qKey: 'faq.q11', aKey: 'faq.a11' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqKeys.map(({ qKey, aKey }) => ({
    '@type': 'Question',
    name: translate('en', qKey),
    acceptedAnswer: {
      '@type': 'Answer',
      text: translate('en', aKey),
    },
  })),
};
---

<section class="flex min-h-screen w-full flex-col justify-center px-8" aria-labelledby="faq-heading">
  <div class="text-center">
    <h2 id="faq-heading" class="text-2xl sm:text-3xl font-semibold tracking-tight" data-i18n="faq.title">{translate('en', 'faq.title')}</h2>
    <p class="mt-2 text-sm" style="color: var(--color-text-subtle);" data-i18n="faq.subtitle">{translate('en', 'faq.subtitle')}</p>
  </div>

  <div class="card mt-8 overflow-hidden" style="padding: 0;">
    <div class="divide-y" style="border-color: var(--color-border);">
      {faqKeys.map(({ qKey, aKey }) => (
        <details class="group">
          <summary
            class="cursor-pointer list-none px-5 py-4 font-medium flex items-center justify-between gap-3 hover:bg-black/5"
            style="list-style: none;"
          >
            <span data-i18n={qKey}>{translate('en', qKey)}</span>
            <span
              aria-hidden="true"
              class="text-xl transition-transform group-open:rotate-45 shrink-0"
              style="color: var(--color-text-subtle);"
            >+</span>
          </summary>
          <div class="px-5 pb-4 pt-0 text-sm leading-relaxed" style="color: var(--color-text-muted);">
            <p data-i18n={aKey}>{translate('en', aKey)}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
